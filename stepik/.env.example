# Скопируйте в stepik/.env и впишите свой ключ, например:
#   cp .env.example .env
#   sed -i "s/^QDRANT__SERVICE__API_KEY=.*/QDRANT__SERVICE__API_KEY=$(openssl rand -hex 32)/" .env
#
# stepik/.env в .gitignore (*/.env) - в репозиторий секрет не попадёт.
# Этот файл без секрета можно коммитить: он документирует, что нужно задать.
QDRANT__SERVICE__API_KEY=
